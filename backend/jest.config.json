{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/__tests__/**/*.test.ts", "**/*.spec.ts"],
  "moduleNameMapper": {
    "^@shared/(.*)$": "<rootDir>/../shared/$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "collectCoverageFrom": ["src/**/*.ts", "!src/server.ts", "!src/db/seed.ts"],
  "testTimeout": 15000
}
