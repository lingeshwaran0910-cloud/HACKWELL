DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safecity?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info

# Firebase Admin Configuration
FIREBASE_PROJECT_ID="safecity-ai-dev"
# For local dev with Firestore Emulator:
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Optional Production Credentials (DO NOT COMMIT REAL SECRETS)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@safecity-ai-dev.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AI Provider Configuration
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

